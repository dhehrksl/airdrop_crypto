# 서버
PORT=4000
NODE_ENV=development

# MongoDB (Atlas 또는 로컬)
MONGO_URI=mongodb://127.0.0.1:27017/airdrop_crypto

# Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 텔레그램 봇 (선택사항 - 비워두면 mock 데이터 사용)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=@AirdropDetective,@AirdropCryptoOfficial

# 웹 크롤링 타겟 (쉼표 구분, 비워두면 mock 사용)
WEB_SOURCES=

# 신뢰도 임계치 (이 점수 이상만 DB 적재)
TRUST_SCORE_THRESHOLD=80

# 크롤링 주기 (cron 표현식, 기본 1시간)
CRAWL_CRON=0 * * * *

# 알림 웹훅 (Slack/Discord, 선택사항)
ALERT_WEBHOOK_URL=

# Mock 모드 (true면 외부 호출 없이 샘플 데이터 사용)
USE_MOCK=true

# 푸시 알림 잡 (15분 주기 기본)
PUSH_CRON=*/15 * * * *

# Sentry (선택)
SENTRY_DSN=

# 관리자 API 토큰 (관리자 대시보드 접근용)
ADMIN_TOKEN=changeme_admin_token
